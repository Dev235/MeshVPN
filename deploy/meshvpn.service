[Unit]
Description=MeshVPN Headless Client Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/meshvpnd --control=http://control.example.com:8080 --relay=relay.example.com:41641
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
